# ────────────────────────────────────────────────────────────────
# Builder stage: compile Bifrost & popins4snake
# ────────────────────────────────────────────────────────────────
FROM ubuntu:20.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive

# Install build dependencies
RUN apt-get update && apt-get install -y \
    git \
    build-essential \
    cmake \
    libbz2-dev \
    liblzma-dev \
    zlib1g-dev \
    libcurl4-gnutls-dev \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /opt

# Clone popins4snake with its submodules
RUN git clone --recursive https://github.com/kehrlab/popins4snake.git popins4snake

# Build and install Bifrost
WORKDIR /opt/popins4snake/external/bifrost
RUN mkdir build && cd build \
 && cmake .. -DCMAKE_INSTALL_PREFIX=../local -DMAX_KMER_SIZE=64 \
 && make \
 && make install

# Build popins4snake
WORKDIR /opt/popins4snake
RUN mkdir build \
 && make

RUN cp popins4snake /usr/local/bin/

# Clone and build Sickle
WORKDIR /opt
RUN git clone --recursive https://github.com/najoshi/sickle.git sickle 

WORKDIR /opt/sickle
RUN make
RUN cp sickle /usr/local/bin/

# ────────────────────────────────────────────────────────────────
# Runtime stage: lean image with extra bio-tools
# ────────────────────────────────────────────────────────────────
FROM docker.io/continuumio/miniconda3:latest

# Add Bioconda & Conda-Forge channels, install tools
RUN conda config --remove channels defaults \
 && conda config --add channels conda-forge \
 && conda config --add channels bioconda \
 && conda config --set channel_priority strict

RUN conda install -y mamba \
 && mamba install -y --override-channels\
      -c conda-forge \
      -c bioconda \
      python=3.11 \
      ipython=8.22.0 \
      notebook \
      papermill \
      biopython \
      pysam \
      seaborn \
      plotly \
      python-kaleido \
      bwa \
      samtools \
      velvet \
      bcftools=1.15 \
      kraken2 \
 && mamba clean -afy

# ────── Generate and tweak Jupyter defaults ──────
RUN jupyter notebook --generate-config \
 && sed -i \
      -e "s|#c.NotebookApp.ip = 'localhost'|c.NotebookApp.ip = '0.0.0.0'|" \
      -e "s|#c.NotebookApp.open_browser = True|c.NotebookApp.open_browser = False|" \
      ~/.jupyter/jupyter_notebook_config.py \
 && printf "\
c.NotebookApp.token = ''\n\
c.NotebookApp.password = ''\n\
c.NotebookApp.allow_root = True\n" \
    >> ~/.jupyter/jupyter_notebook_config.py

# Copy the compiled binary in
COPY --from=builder /usr/local/bin/popins4snake /usr/local/bin/
COPY --from=builder /usr/local/bin/sickle /usr/local/bin/

# Expose Jupyter’s default port
EXPOSE 8888
